msgstr "一段古老的传说重现！这会改变一切吗？"

msgid "quest_trigger_success"
msgstr "新的任务开始了！下一个挑战在召唤你。"

msgid "menu_intro"
msgstr "按任意键"

msgid "water_campaign"
msgstr "Tuxemon：混沌之潮"

msgid "empty"
msgstr "空无"

msgid "ambuwl_description"
msgstr "它育儿袋中的蛋不会孵化。取而代之的是，它会分泌出一种具有恢复功效的美味饮品。"

msgid "ambuwl"
msgstr "救护枭"

msgid "ampystoma_description"
msgstr "你或许以为电螈的警戒色会让伏击无从谈起，但它捕猎的浑浊水域会将其隐藏，直到它准备好现身。它喜欢在雷暴天气时上岸。"

msgid "ampystoma"
msgstr "电螈"

msgid "angesnow_description"
msgstr "那些在恶劣冰雪环境中迷路后幸存下来的人，常常提到有一个神秘的存在引导着他们，哪怕大雪弥漫、无法视物。"

msgid "angesnow"
msgstr "雪天使"

msgid "askylpaws_description"
msgstr "它是灾难的预兆，常现身于多事之秋。这使得人们有时会把不幸归咎于它。"

msgid "askylpaws"
msgstr "天空爪"

msgid "asudopt_description"
msgstr "传说中，阿苏多普特创造了世界，也终将在某一天毁灭世界。在此期间，它制定着世间的普遍法则。"

msgid "asudopt"
msgstr "阿苏多普特"

msgid "babysnitch_description"
msgstr "怒气冲冲的告密崽会猛地扑向敌人，但通常收效甚微。但要小心：如果你嘲笑它的努力，等它进化成坏抓抓后，就会来找你算账。"

msgid "babysnitch"
msgstr "告密崽"

msgid "baddrscratch_description"
msgstr "暴怒的坏抓抓是可怕的猎手，它追逐猎物时从不停歇——哪怕面对必死的命运。"

msgid "baddrscratch"
msgstr "坏抓抓"

msgid "bansaken_description"
msgstr "暮色降临时，班萨肯体内的灵魂便苏醒过来。它们喜欢把熬夜不睡的淘气孩子也拉进自己的行列。"

msgid "bansaken"
msgstr "班萨肯"

msgid "banvengeance_description"
msgstr "香蕉复仇试图用蔓延的根系长出新树来遮蔽光明，为自己制造黑夜，同时扼杀与之竞争的植物。"

msgid "banvengeance"
msgstr "香蕉复仇"

msgid "bedoo_description"
msgstr "它将猎物整个吞下，让其陷入数小时的沉睡，自己则饱餐它们的梦境。它常常会不小心让猎物陷入永恒的长眠。"

msgid "bedoo"
msgstr "贝多"

msgid "bewhich_description"
msgstr "小巫屏住呼吸时，能化作美丽——却带着邪气——的人形。"

msgid "bewhich"
msgstr "小巫"

msgid "birdee_description"
msgstr "它是杂食性的，但偏爱肉食还是种子，取决于它幼年时的经历。"

msgid "birdee"
msgstr "小鸟迪"

msgid "bishosand_description"
msgstr "沙主教对看到的宗教或灵性符号十分着迷，喜欢收集它们，但据说它一个也看不懂。"

msgid "bishosand"
msgstr "沙主教"

msgid "blasdoor_description"
msgstr "爆门用自己坚不可摧的身躯护住所在乎的对象，却用钢牙把不速之客和废旧机器嚼个粉碎。"

msgid "blasdoor"
msgstr "爆门"

msgid "boxorox_description"
msgstr "它越是犯傻，岩石般的身体就越坚硬。"

msgid "boxorox"
msgstr "拳击岩"

msgid "brachifor_description"
msgstr "布拉奇只要保持完全静止，就可以不吃东西。"

msgid "brachifor"
msgstr "布拉奇"

msgid "breem_description"
msgstr "夜里它刺破果实，把新生的达贡放进去。白天则假装成一只普通的蜜蜂。"

msgid "breem"
msgstr "布林"

msgid "bricgard_description"
msgstr "冬天来临时，砖愚会用砖块筑成防御茧，保护自己免受捕食者的侵害。"

msgid "bricgard"
msgstr "砖卫"

msgid "brickhemoth_description"
msgstr "踢砖卫的巢穴时要当心，因为一旦它进化成砖巨兽，震动就会成为这只精灵破巢而出的信号。"

msgid "brickhemoth"
msgstr "砖巨兽"

msgid "brumi_description"
msgstr "被冷落的扫帚可能会被布鲁米偷走。"

msgid "brumi"
msgstr "布鲁米"

msgid "burrlock_description"
msgstr "刺巫喜欢粘在路人身上，借此四处传播。"

msgid "burrlock"
msgstr "刺巫"

msgid "cacaburr_description"
msgstr "可可刺供养着许多传粉者，比如不倒蜂，还有爱吃种子的山雀。"

msgid "cacaburr"
msgstr "可可刺"

msgid "cackleen_description"
msgstr "有人说咯咯巫是被附身的孩子，也有人说她是一个女孩迷失的灵魂。"

msgid "cackleen"
msgstr "咯咯巫"

msgid "caper_description"
msgstr "卡珀们在冰冷刺骨的山间河流的浪花中相互嬉戏玩耍。"

msgid "caper"
msgstr "卡珀"

msgid "capinyah_description"
msgstr "只有在丛林中历经艰苦训练，举起原木和河中巨石之后，卡皮蒂才能进化为卡皮尼亚。"

msgid "capinyah"
msgstr "卡皮尼亚"

msgid "carcharock_description"
msgstr "岩鲨的古老本能与现代世界格格不入，法凡的气息和潘特拉菲拉的咆哮，已取代了它故乡熟悉的声音。"

msgid "carcharock"
msgstr "岩鲨"

msgid "cherubat_description"
msgstr "这些好奇的蝙蝠被恋人们浓烈的情感所吸引，会把无人看管的花束和巧克力盒搬回去筑巢。"

msgid "cherubat"
msgstr "天使蝠"

msgid "chickadee_description"
msgstr "如果山雀察觉到的危险比另一个要小，它发出的「嘀嘀」叫声就会拖得更长。"

msgid "chickadee"
msgstr "山雀"

msgid "claymorior_description"
msgstr "据说一千只大剑土中，才有一只能成为统治它们的王者天平。"

msgid "claymorior"
msgstr "大剑土"

msgid "coaldiak_description"
msgstr "这只熊能在任何地方纵火，也能从任何东西身上见血。"

msgid "coaldiak"
msgstr "煤达克"

msgid "cobarett_description"
msgstr "它周身笼罩着滚滚浓烟，好让自己在茂密的灌木丛中穿行自如。浓烟来自它熔岩般的体温，温度之高，连嘴里都会喷出火舌。"

msgid "cobarett"
msgstr "眼镜蛇特"

msgid "cocrune_description"
msgstr "无论它转向哪边，那只血红色的眼睛都正对着你。"

msgid "cocrune"
msgstr "可可符文"

msgid "cohldrabi_description"
msgstr "它出生在寒冷多雪地区的地下，几周内就能学会飞行。"

msgid "cohldrabi"
msgstr "寒龙"

msgid "conglolem_description"
msgstr "凝胶早已干涸，但砾魔像仍在继续前行。"

msgid "conglolem"
msgstr "砾魔像"

msgid "coppi_description"
msgstr "科皮的花出奇地又苦又臭，但在酿酒和制药方面却很有用。"

msgid "coppi"
msgstr "科皮"

msgid "crankus_description"
msgstr "从一个山顶到另一个山顶，都能听到暴躁克们相互咩叫争吵，直到春来雪融才肯罢休。"

msgid "crankus"
msgstr "暴躁克"

msgid "crustagu_description"
msgstr "它从爪中射出锐利的毒刺，吓退那些威胁其水下群落的家伙。"

msgid "crustagu"
msgstr "甲壳古"

msgid "dankush_description"
msgstr "丹库什屏住呼吸就能阻止自己燃烧，这时每片叶子都会冒出滚滚浓烟。"

msgid "dankush"
msgstr "丹库什"

msgid "delfeco_description"
msgstr "德尔费科流线型的身体让它在水中穿梭自如，其智慧体现在复杂的捕猎策略中。尽管体型庞大，它却以爱玩的天性和与训练师之间深厚的羁绊而闻名。"

msgid "delfeco"
msgstr "德尔费科"

msgid "demosnow_description"
msgstr "雪魔以引诱旅人深入荒野险境为乐，向他们许诺荣耀与冒险。"

msgid "demosnow"
msgstr "雪魔"

msgid "devidin_description"
msgstr "一只复活的二齿兽，决定干脆变成大家一直误以为它是的那种恐龙。"

msgid "devidin"
msgstr "德维丁"

msgid "devidra_description"
msgstr "仔细看，那身极细的毛发暴露了它正在恶魔般地假扮恐龙。"

msgid "devidra"
msgstr "恶魔海德拉"

msgid "deviraptor_description"
msgstr "它头上那唯一的一对羽毛是假的，暗示着它恶魔般的真实身份。"

msgid "deviraptor"
msgstr "恶魔迅猛龙"

msgid "doctsky_description"
msgstr "这只小鬣狗只是想照顾别人，但自从一部以它为反派的电影上映后，它的名声就坏了。"

msgid "doctsky"
msgstr "天空博士"

msgid "drashimi_description"
msgstr "它躺在地上，散发着诱人的香气，引诱精灵来咬一口——但等它们靠近，它就先下口为强。"

msgid "duggot_description"
msgstr "当不倒蜂想喝果汁时，达贡可能会附上去，接管它的大脑。"

msgid "duggot"
msgstr "达贡"

msgid "equill_description"
msgstr "心中的怨恨促使它变身。它把自己的丑陋藏在黑暗之中。"

msgid "equill"
msgstr "针鳗"

msgid "erythroskyte_description"
msgstr "它性情友善，但那条巨大的针管尾巴还是吓跑了许多人。"

msgid "erythroskyte"
msgstr "红空"

msgid "eskipup_description"
msgstr "即使还是幼犬，它也能拉动一吨重的货物。"

msgid "eskipup"
msgstr "雪橇犬"

msgid "firomenis_description"
msgstr "这些精灵在梅利昆阶段度过了漫长岁月，因此体型庞大、皮糙肉厚。它们的下颚能咬碎树木和骨头，飞行之力足以载人。"

msgid "flisces_description"
msgstr "它贴着水面滑行，避开侦测，然后猛地一跃，用锋利的鳍发动攻击。"

msgid "flisces"
msgstr "弗利塞斯"

msgid "flounce_description"
msgstr "弗劳恩斯既固执又孤僻，除非有充分的理由，否则它对所有规矩都不屑一顾。"

msgid "flounce"
msgstr "弗劳恩斯"

msgid "flummack_description"
msgstr "弗鲁马克不再渴望被吃，而是渴望去吃——连其他的弗伦比和弗鲁马克都能成为它的美餐。"

msgid "flummack"
msgstr "弗鲁马克"

msgid "flummby_description"
msgstr "弗伦比是一位科学家发明的，他认为自愿被吃的食物更合乎道德。它会主动跳进任何能吃掉它的生物嘴里。"

msgid "flummby"
msgstr "弗伦比"

msgid "fribbit_description"
msgstr "据说它曾是一个男孩，因为舔了结冰的路灯柱而变成了这样。"

msgid "fribbit"
msgstr "弗洛蛙"

msgid "frostuce_description"
msgstr "谁也想不到会在暴风雪中看到一棵绿色植物翩翩起舞。"

msgid "frostuce"
msgstr "冰生菜"

msgid "fuzzina_description"
msgstr "当抛弃小绒球的孩子再次需要它时，它便进化为绒绒，成为弱小者勇敢的保护者和养育者。"

msgid "fuzzina"
msgstr "绒绒"

msgid "fuzzlet_description"
msgstr "当孩子不再陪玩具玩耍时，它们有时便会活过来。"

msgid "fuzzlet"
msgstr "小绒球"

msgid "galasces_description"
msgstr "加拉斯能扭曲自己的形体，吞下与自己体型相当的猎物。"

msgid "galasces"
msgstr "加拉斯"

msgid "gastronium_description"
msgstr "美食家几乎什么都能吃，但偏爱密度大的放射性物质。"

msgid "gastronium"
msgstr "美食家"

msgid "dynastor_description"
msgstr "迪纳斯托是一种巨大的昆虫型精灵，身披厚重的装甲外骨骼，背上长着独特的翅膀。它的大颚能咬碎钢铁。"

msgid "dynastor"
msgstr "迪纳斯托"

msgid "gliffary_description"
msgstr "这是一种罕见的淘气妖精生物，它们聚集在蘑菇圈旁，热衷于熔化铁器。"

msgid "gliffary"
msgstr "格利法"

msgid "glombroc_description"
msgstr "它把记忆储存在岩石外壳里。如果有碎片掉落，它就会变得健忘。"

msgid "glombroc"
msgstr "格隆布罗克"

msgid "glomon_description"
msgstr "一群细菌在一只被丢弃的医用手套中孕育出的新生命。它能从身体的背后看东西。"

msgid "glomon"
msgstr "格洛蒙"

msgid "golnagi_description"
msgstr "戈尔纳吉的鳞片会发光，使它在黎明和黄昏的水中几乎隐形——这正是它偏爱的捕猎时间。"

msgid "golnagi"
msgstr "戈尔纳吉"

msgid "gourda_description"
msgstr "在种植最大葫芦达的比赛中，有些个体重达一吨，但普通的葫芦达要小得多。"

msgid "gourda"
msgstr "葫芦达"

msgid "gryfix_description"
msgstr "骨骼护甲保护着格里菲克斯，只有最强的攻击才能伤到它。"

msgid "gupphire_description"
msgstr "蓝灯鱼的鳞片闪闪发光，美得令人惊叹。渔民们相信看到蓝灯鱼就意味着一整年都会有好运。"

msgid "gupphire"
msgstr "蓝灯鱼"

msgid "gupphish_description"
msgstr "古比鱼喜欢成群结队地游动，因此深受重视团队合作的训练师喜爱。"

msgid "gupphish"
msgstr "古比鱼"

msgid "hectapod_description"
msgstr "当它鼓起圆顶时，就能浮到海面，甚至穿过薄雾与云层。"

msgid "hectapod"
msgstr "百足"

msgid "helipi_description"
msgstr "它靠单翼旋转飞行比用双翼飞得更远，但代价是难以控制方向。"

msgid "helipi"
msgstr "赫利皮"

msgid "hissiorite_description"
msgstr "它的颈部底部会喷出超高温气体，包裹住全身，让它像热气球一样悬浮在离地几英寸的空中。因此它能快速移动，甚至可以掠过水面。"

msgid "hissiorite"
msgstr "嘶石岩"

msgid "hoarse_description"
msgstr "它看起来像一只农场动物，但曾遭到主人的虐待。"

msgid "hoarse"
msgstr "嘶马"

msgid "hoarseshoo_description"
msgstr "它是针鳗的影子吃掉自己身体后留下的东西。"

msgid "hoarseshoo"
msgstr "马蹄铁"

msgid "hoodoll_description"
msgstr "它有时会把针扎进自己身体来诅咒敌人，但事后谁也看不出有什么区别。"

msgid "hoodoll"
msgstr "巫毒娃娃"

msgid "hotline_description"
msgstr "这种好奇的生物能跳出很远的距离，发出一种奇怪的金属般叫声，无论猎物跑多远都无法摆脱。"

msgid "hotline"
msgstr "热线"

msgid "houndice_description"
msgstr "冰猎犬喜欢滑雪橇，但它也能嗅出被雪掩埋的迷路徒步者。"

msgid "houndice"
msgstr "冰猎犬"

msgid "howl_description"
msgstr "嚎狼愚笨的外表下藏着深邃的智慧——可惜它无法表达，说出的话都变成了嚎叫。"

msgid "howl"
msgstr "嚎狼"

msgid "imbrickcile_description"
msgstr "砖愚躲在一块砖里栖身，只有搬砖锻炼力量时才会出来。"

msgid "imbrickcile"
msgstr "砖愚"

msgid "jeluna_description"
msgstr "月亮对月光水母施加着奇异的影响，让这些空中水母在一个月内不断变换形态。"

msgid "jeluna"
msgstr "月光水母"

msgid "joulraton_description"
msgstr "它带静电的刚毛皮毛会吸附种子、花朵和羽毛，用作食物或筑巢材料。"

msgid "joulraton"
msgstr "尤尔鼠"

msgid "kernel_description"
msgstr "科内尔是精灵系统（仓库）和道具系统（柜子）的核心组件，是计算机物理硬件与运行进程之间的主要接口。它的创造者称之为JAS-KERI-BIT。"

msgid "kernel"
msgstr "科内尔"

msgid "knightsand_description"
msgstr "沙骑士在沙爪居住的沙堡周围巡逻，但它自己却不擅长建造沙堡。"

msgid "knightsand"
msgstr "沙骑士"

msgid "knindling_description"
msgstr "火薪会兴高采烈地把石头迸出的任何火星都养成火焰。"

msgid "knindling"
msgstr "火薪"

msgid "komoduel_description"
msgstr "许多作恶者只看到科莫多决斗逼近的剪影，就仓皇逃出了城。"

msgid "komoduel"
msgstr "科莫多决斗"

msgid "konuit_description"
msgstr "在有些地方，科努被称为「坠落熊」，人们相信它会从树上掉到毫无防备的路人头上。"

msgid "konuit"
msgstr "科努"

msgid "kroki_description"
msgstr "克罗克大部分时间都待在浅水里，用强有力的双颚猛咬猎物。"

msgid "kroki"
msgstr "克罗克"

msgid "krokivip_description"
msgstr "这种有毒的鳄类喜欢从水中发动伏击。越接近进化，它就越倾向于寻找更大的水域。"

msgid "krokivip"
msgstr "克罗克毒蛇"

msgid "legoplaste_description"
msgstr "它的形体极不稳定，捕猎时会随意伸出触手去嗅探或触碰附近的猎物。"

msgid "legoplaste"
msgstr "积木塑"

msgid "lendos_description"
msgstr "当两只独眼缠在一起时，就会合体成一只伦多斯。"

msgid "lendos"
msgstr "伦多斯"

msgid "lesmagu_description"
msgstr "它在海底缓缓蠕动，寻找坚硬的缝隙藏身，直到长出自己的壳。"

msgid "lesmagu"
msgstr "莱斯马古"

msgid "lettice_description"
msgstr "寒冷的天气会凝聚生菜的力量与活力。"

msgid "lettice"
msgstr "生菜"

msgid "leviadile_description"
msgstr "凭借庞大的身躯与剧毒的巨颚，海鳄是深海中称霸一方的掠食者。"

msgid "leviadile"
msgstr "海鳄"

msgid "loliferno_description"
msgstr "据说罗利弗诺的火焰永远无法熄灭。然而尽管力量强大，罗利弗诺也有顽皮的一面，人们常看到它在自己燃起的火焰中起舞。"

msgid "lucifice_description"
msgstr "那是穿过林间呼啸的风声，还是冰魔在召唤黑夜的暗影加入它的狩猎？"

msgid "lucifice"
msgstr "冰魔"

msgid "lunight_description"
msgstr "月光兽是夜晚的守护者，能够操控月亮及其盈亏圆缺。"

msgid "magmaturtle_description"
msgstr "受到威胁时，它会缩回壳中，通过排放蒸汽急剧降温，可能会被误认为是岩石。"

msgid "marvantis_description"
msgstr "进化之后，它原本拟态的唯一痕迹就只剩下那红色的饰纹了。"

msgid "marvantis"
msgstr "马文提斯"

msgid "marvillar_description"
msgstr "马维拉用气味伪装成蚂蚁幼虫，哄骗绯红和蚁兵喂养自己，并吃掉那些起疑心的家伙。"

msgid "marvillar"
msgstr "马维拉"

msgid "mauai_description"
msgstr "莫艾将自己托付给了封印在其武器中的阵亡战士之魂。"

msgid "mauai"
msgstr "莫艾"

msgid "medipup_description"
msgstr "医护犬一旦嗅出病痛，就会蹦跳着凑过去，用鼻子蹭蹭患病的精灵。医护犬湿润的鼻子很有效，但也有一些病人被过于热情的一群医护犬压得喘不过气。"

msgid "medipup"
msgstr "医护犬"

msgid "megafruitera_description"
msgstr "它比幼年形态稍能自控，需要更多果实的时候，会先把自己的巢穴扩大。"

msgid "megafruitera"
msgstr "巨果"

msgid "merlicun_description"
msgstr "梅利昆是一种顽强的昆虫，进化后在攻击与防御上都十分高效。它们聚集在古老森林的树冠中，以果实和树叶为食。"

msgid "metoxic_description"
msgstr "金毒有时会充当沙爪城堡的旗帜，向四周喷吐有毒的烟雾。"

msgid "metoxic"
msgstr "金毒"

msgid "mingdyn_description"
msgstr "每隔12年，才会有一枚明朝的蛋降生。它的发现标志着整片大地迎来革新与动荡的时刻。"

msgid "mingdyn"
msgstr "明朝"

msgid "myrmison_description"
msgstr "蚁兵的蚁后会在潮湿的日子里现身，试图建立新的群落。这对它们来说是非常危险的时刻。"

msgid "myrmison"
msgstr "蚁兵"

msgid "nebufin_description"
msgstr "星云鳍天使般的外表具有欺骗性，这种精灵其实是掠食者。"

msgid "nebufin"
msgstr "星云鳍"

msgid "ned_description"
msgstr "内德和科努是一对冤家，但它们的争吵大多时候都以科努睡过去收场。"

msgid "ned"
msgstr "内德"

msgid "nimbulex_description"
msgstr "云布雷克斯用火花与雷云包裹自己，以保护其脆弱的内在核心。"

msgid "nimbulex"
msgstr "云布雷克斯"

msgid "ninjasmine_description"
msgstr "忍茉莉用他的两把毒剑迅速地让对手中毒。"

msgid "ninjasmine"
msgstr "忍茉莉"

msgid "novaquarius_description"
msgstr "被新水瓶蜇到的粗心家伙得进医院，但巴布龟已经进化出了免疫力，还会啃上它们几口。"

msgid "novaquarius"
msgstr "新水瓶"

msgid "parappi_description"
msgstr "帕拉皮被割伤时会渗出糖浆，糖浆在敌人身上凝固变硬，将他们变成琥珀。"

msgid "parappi"
msgstr "帕拉皮"

msgid "pawsand_description"
msgstr "沙爪栖息在沙主教和沙堡建造的沙城堡与沙神庙中，其中有些实际上就是沙堡本堡。"

msgid "pawsand"
msgstr "沙爪"

msgid "pearamanca_description"
msgstr "梨螈会向只是想买水果的无辜人们推销保险，这使它成为最可怕的精灵。"

msgid "pearamanca"
msgstr "梨螈"

msgid "pharavion_description"
msgstr "经过一番苦心培育，训练师可以把笨手笨脚的法凡幼崽进化为成体形态——尽管体型巨大，它仍能优雅地飘浮。"

msgid "pharavion"
msgstr "法老鸟"

msgid "pickoon_description"
msgstr "它喜欢捡起各种东西，再偷偷塞进自己的围巾里。"

msgid "pickoon"
msgstr "皮昆"

msgid "potturmeist_description"
msgstr "陶罐大师是寄居在空器皿中的亡魂。在古老的神庙里，侍僧们必须引开这些精灵，以免它们打断重要的仪式。"

msgid "potturmeist"
msgstr "陶罐大师"

msgid "potturney_description"
msgstr "当陶罐大师长到成熟时，它那护身的陶罐已经变得面目全非，不像任何人手制作的陶器。有人坚称，陶罐大师罐身上的纹样是来自遥远未来的文字。"

msgid "potturney"
msgstr "陶罐旅"

msgid "primordia_description"
msgstr "据说它是所有精灵的祖先。"

msgid "primordia"
msgstr "原初"

msgid "pythonova_description"
msgstr "它脾气暴躁，发怒时背上的火焰烧得更旺，烟雾尾巴也变得又粗又长。它会用烟雾尾巴缠住目标，使其窒息。"

msgid "pythonova"
msgstr "蟒蛇新星"

msgid "raccscal_description"
msgstr "它背上长着一条袋子般的尾巴，可以开合，甚至能拆下来扔向敌人。"

msgid "raccscal"
msgstr "浣熊混混"

msgid "raptoucan_description"
msgstr "它既凶猛又好斗，却只吃水果。"

msgid "raptoucan"
msgstr "迅猛巨嘴"

msgid "regalance_description"
msgstr "它随时都能召唤出一柄戟。"

msgid "regalance"
msgstr "王者天平"

msgid "rhinocarpe_description"
msgstr "犀鲤领地意识极强，任何游得太靠近它们珊瑚堡垒的家伙，都会遭到迎头冲撞。"

msgid "rhinocarpe"
msgstr "犀鲤"

msgid "rinocereed_description"
msgstr "由于长得太快，它总是饥肠辘辘——而且它的食物并不限于植物。"

msgid "rinocereed"
msgstr "芦犀"

msgid "rooksand_description"
msgstr "沙堡有时会允许它认可的家伙住进自己的沙城堡，其余的则一律碾碎。"

msgid "rooksand"
msgstr "沙堡"

msgid "ruffalo_description"
msgstr "毛牛力大无穷，能高速冲锋，足以撞翻树木和小型建筑。"

msgid "ruffalo"
msgstr "毛牛"

msgid "runesquito_description"
msgstr "那血红的纹样才是符文蚊，其余的不过是它搭乘的岩石外壳。"

msgid "runesquito"
msgstr "符文蚊"

msgid "scarlant_description"
msgstr "它最大的敌人是马维拉，后者会假扮成它的同类。"

msgid "scarlant"
msgstr "绯红"

msgid "seraphice_description"
msgstr "冰天使能将充满勇气与喜悦的瞬间封入冰中，珍藏在群山深处的地窖里，等待人类最需要它们的那一天。"

msgid "seraphice"
msgstr "冰天使"

msgid "shelagu_description"
msgstr "它把嘴里吐出的黏液涂在带刺的壳上，以此毒退来犯者。"

msgid "sheye_description"
msgstr "羞眼被沉重的思绪压得喘不过气。叛逆的训练师喜欢它们那副阴沉的外表与严肃的举止。"

msgid "sheye"
msgstr "羞眼"

msgid "shimmerain_description"
msgstr "人们说，当水面上升起彩虹时，就是闪光雨在产卵。"

msgid "shimmerain"
msgstr "闪光雨"

msgid "shrab_description"
msgstr "当羞眼从无尽的沉思中解脱出来时，它就会变成灌木蟹，身体自由地漫游世界。"

msgid "shrab"
msgstr "灌木蟹"

msgid "shull_description"
msgstr "沙尔不需要进食，也不需要移动，但它仍喜欢最喜欢的人给的零食和营养品——尤其是在经常被派去战斗的时候。"

msgid "shull"
msgstr "沙尔"

msgid "slichen_description"
msgstr "它是一团获得了生命的凝胶，开始用石块和岩石为自己打造身体。"

msgid "slichen"
msgstr "苔泥"

msgid "spectera_description"
msgstr "这种长着叶子翅膀的蝙蝠是杂食性的，但更爱吃水果。雄性和雌性都会照顾幼崽。"

msgid "spectera"
msgstr "幽灵"

msgid "sphake_description"
msgstr "斯芬克有时会制造小型地震，把书架上的书和杯子震落下来，给人添麻烦；掉下来的东西都归它吃。"

msgid "sphake"
msgstr "斯芬克"

msgid "spirain_description"
msgstr "如果塞雷因内心的火焰黯淡下去，它的水灵本性就会将它变成螺旋雨。"

msgid "spirain"
msgstr "螺旋雨"

msgid "sprightly_description"
msgstr "一种胆小的植物，会从土里探出头来，汲取水分与阳光。"

msgid "sprightly"
msgstr "斯普莱特利"

msgid "sprorm_description"
msgstr "孢虫是赤焰鹰的食物，赤焰鹰能把它融成一滩。"

msgid "sprorm"
msgstr "孢虫"

msgid "squink_description"
msgstr "它的名字来源于墨水用光时发出的声音。"

msgid "squink"
msgstr "墨鱿"

msgid "stegofor_description"
msgstr "到了变身的时节，剑龙会成群结队地沿着古老的路径迁徙，沿途把植物的叶子啃个精光。"

msgid "stegofor"
msgstr "剑龙"

msgid "stomic_description"
msgstr "斯托米克具有放射性，但像格洛蒙这样的抗辐射细菌仍能对它造成威胁。"

msgid "stomic"
msgstr "斯托米克"

msgid "stonifly_description"
msgstr "石蝇坚硬如石的外骨骼是天然的铠甲，半透明的翅膀则让它能够敏捷地飞行。"

msgid "stonifly"
msgstr "石蝇"

msgid "sumobug"
msgstr "相扑虫"

msgid "sumobug_description"
msgstr "它利用体重绊倒比自己大得多的敌人，密度堪比恒星。"

msgid "tadcool_description"
msgstr "当有人走近薄冰时，它会呱呱叫着发出警告。"

msgid "tadcool"
msgstr "酷蝌蚪"

msgid "thumpurn_description"
msgstr "它们用拳头捶打敌人，也会捶击地面发出警告。"

msgid "thumpurn"
msgstr "砰砰瓮"

msgid "tobishimi_description"
msgstr "托比希米一次产下大量的卵，把它们护在下巴底下，直到下一个满月——那时幼崽便会孵化。"

msgid "tornicane_description"
msgstr "龙卷风同时驾驭着龙卷与飓风的力量。它是活着的自然之力，对盼雨的人来说，它既是救星，也可能是灾厄。"

msgid "tornicane"
msgstr "龙卷风"

msgid "toucanary_description"
msgstr "大嘴鹦之所以有鲜艳的羽毛，只是因为它在花丛中长大。"

msgid "toucanary"
msgstr "大嘴鹦"

msgid "toxiris_description"
msgstr "毒鸢极其强大，会凶猛地毒倒挡在它路上的一切。"

msgid "toxiris"
msgstr "毒鸢"

msgid "trojerror_description"
msgstr "木马错误是一种伪装成合法代码或软件的精灵。一旦进入网络，木马错误便能执行合法用户可以执行的任何操作（存入、取出与删除）。"

msgid "trojerror"
msgstr "木马错误"

msgid "tsushimi_description"
msgstr "鹤见身上的肉质甲片有时被当作它的铠甲，其实比它的皮肤还要柔软。它们的用途至今仍是个谜。"

msgid "tumbledillo_description"
msgstr "滚球犰狳与某一条道路有着神秘的联系，会守护它免受任何人的破坏——哪怕是修补坑洞的施工队也不例外！"

msgid "tumbledillo"
msgstr "滚球犰狳"

msgid "tumblequill_description"
msgstr "风滚鼠沿着公路滚动，从路边丢弃的垃圾中收集有用的东西来筑巢。"

msgid "tux_description"
msgstr "小企鹅在北极气候中最为自在，它们会扑向较弱的猎物，而对付较强的猎物时，则把它在冰面上一路滑向坚硬的岩石，撞碎它的外壳或铠甲。"

msgid "uf0_description"
msgstr "这种奇异的生物似乎会被人类耳朵听不到的高频声音所吸引。"

msgid "uf0"
msgstr "幽浮零"

msgid "uglip_description"
msgstr "如果把丑丑从深海的家园里太快地拉上来，它就会浑身肿胀，痛苦不堪。"

msgid "uglip"
msgstr "丑丑"

msgid "uneye_description"
msgstr "独眼潜伏在阴影中，徘徊在视线的边缘。"

msgid "uneye"
msgstr "独眼"

msgid "uprout_description"
msgstr "长大之后，它的耳朵会剥落，露出翅膀，用它飞回自己生长之地的树梢上。"

msgid "uprout"
msgstr "向上苗"

msgid "urcheedle_description"
msgstr "它既不能移动也不能攻击，只能一动不动地待着，祈祷对手自己撞上它满身的尖刺受伤。"

msgid "urcheedle"
msgstr "针海胆"

msgid "virware_description"
msgstr "毒软通常处于休眠状态，直到受害者通过下载恶意应用或点击受感染的链接触发它。一旦被激活，毒软可以完成各种各样的任务。"

msgid "virware"
msgstr "毒软"

msgid "volconey_description"
msgstr "火山兔用巨大的脚掌捶击大地，召唤越来越多的砰砰瓮和火山兔回到巢穴。但当足够多的它们同时捶击大地时，据说会引发火山喷发。"

msgid "volconey"
msgstr "火山兔"

msgid "vulpyre_description"
msgstr "它如何进化、如何生活都十分神秘，但有人偶尔在火山附近见过它。"

msgid "vulpyre"
msgstr "焰狐"

msgid "waysprite_description"
msgstr "据说当一个人面临艰难抉择时，路精灵就会现身。"

msgid "waysprite"
msgstr "路精灵"

msgid "weedlantis_description"
msgstr "传说一个古老的文明曾以草亚特兰为顾问，但它后来便消失在了海底。"

msgid "weedlantis"
msgstr "草亚特兰"

msgid "weedsea_description"
msgstr "每年一次，它会在水下由灌木蟹这样的水生精灵完成授粉。"

msgid "weedsea"
msgstr "海草"

msgid "wendigger_description"
msgstr "据说未能妥善安葬的尸体会长成温迪戈挖。"

msgid "wendigger"
msgstr "温迪戈挖"

msgid "wolffsky_description"
msgstr "这种精灵非常友善。打猎时带上狼天帮忙是很常见的事。"

msgid "wolffsky"
msgstr "狼天"

msgid "wolololl_description"
msgstr "沃罗洛尔锋利的尖刺上沾有致命的毒液。"

msgid "wolololl"
msgstr "沃罗洛尔"

msgid "woodoor_description"
msgstr "当一座鬼屋被烧成灰烬时，有时只剩下一扇前门。它会蹦跳着离开，去寻找下一个家。"

msgid "woodoor"
msgstr "木门"

msgid "yamada"
msgstr "山田"

msgid "yamada_description"
msgstr "幽灵向来以爱恶作剧著称，山田却格外认真地对待法律，甚至认为良好的品行比蛮力更重要。"

msgid "ziggurat_description"
msgstr "没有任何迷宫困得住齐格拉特。它用这些年来走过的所有迷宫的雕刻来装饰自己的巢穴。"

msgid "ziggurat"
msgstr "齐格拉特"

msgid "agnsher_description"
msgstr "由两只精灵融合而成。"

msgid "agnsher"
msgstr "安格舍尔"

msgid "bearloch_description"
msgstr "由两只精灵融合而成。"

msgid "bearloch"
msgstr "湖熊"

msgid "foxko_description"
msgstr "由两只精灵融合而成。"

msgid "foxko"
msgstr "狐狐"

msgid "rocktot_description"
msgstr "由两只精灵融合而成。"

msgid "rocktot"
msgstr "岩薯"

msgid "cat_tobedefined"
msgstr "待定"

msgid "cat_aggregate"
msgstr "聚合体"

msgid "cat_alarm"
msgstr "警报"

msgid "cat_alien"
msgstr "外星"

msgid "cat_amoeba"
msgstr "变形虫"

msgid "cat_amped"
msgstr "通电"

