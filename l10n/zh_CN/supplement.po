msgid "cosmic_berry"
msgstr "宇宙浆果"

msgid "cosmic_berry_description"
msgstr "将精灵的属性变为宇宙系。"

msgid "earth_berry"
msgstr "大地浆果"

msgid "earth_berry_description"
msgstr "将精灵的属性变为土系。"

msgid "fire_berry"
msgstr "火焰浆果"

msgid "fire_berry_description"
msgstr "将精灵的属性变为火系。"

msgid "frost_berry"
msgstr "冰霜浆果"

msgid "frost_berry_description"
msgstr "将精灵的属性变为冰系。"

msgid "heroic_berry"
msgstr "英勇浆果"

msgid "heroic_berry_description"
msgstr "将精灵的属性变为英勇系。"

msgid "metal_berry"
msgstr "金属浆果"

msgid "metal_berry_description"
msgstr "将精灵的属性变为金属系。"

msgid "lightning_berry"
msgstr "闪电浆果"

msgid "lightning_berry_description"
msgstr "将精灵的属性变为闪电系。"

msgid "normal_berry"
msgstr "普通浆果"

msgid "normal_berry_description"
msgstr "将精灵的属性变为普通系。"

msgid "shadow_berry"
msgstr "暗影浆果"

msgid "shadow_berry_description"
msgstr "将精灵的属性变为暗影系。"

msgid "sky_berry"
msgstr "天空浆果"

msgid "sky_berry_description"
msgstr "将精灵的属性变为天空系。"

msgid "venom_berry"
msgstr "毒液浆果"

msgid "venom_berry_description"
msgstr "将精灵的属性变为毒液系。"

msgid "water_berry"
msgstr "水流浆果"

msgid "water_berry_description"
msgstr "将精灵的属性变为水系。"

msgid "wood_berry"
msgstr "林木浆果"

msgid "wood_berry_description"
msgstr "将精灵的属性变为木系。"

msgid "mega_potion"
msgstr "特级治疗药水"

msgid "mega_potion_description"
msgstr "为精灵恢复200点HP。"

msgid "ancient_tea"
msgstr "远古茶"

msgid "ancient_tea_description"
msgstr "为精灵增加4500点经验值。"

msgid "imperial_tea"
msgstr "皇家茶"

msgid "imperial_tea_description"
msgstr "为精灵增加10000点经验值。"

msgid "mystery_tea"
msgstr "神秘茶"

msgid "mystery_tea_description"
msgstr "为精灵增加1500点经验值。"

msgid "tea"
msgstr "茶"

msgid "tea_description"
msgstr "为精灵增加500点经验值。"

msgid "tuxeball_earth"
msgstr "土系精灵球"

msgid "tuxeball_earth_description"
msgstr "更容易捕捉土系精灵。"

msgid "tuxeball_fire"
msgstr "火系精灵球"

msgid "tuxeball_fire_description"
msgstr "更容易捕捉火系精灵。"

msgid "tuxeball_metal"
msgstr "金属精灵球"

msgid "tuxeball_metal_description"
msgstr "更容易捕捉金属系精灵。"

msgid "tuxeball_water"
msgstr "水系精灵球"

msgid "tuxeball_water_description"
msgstr "更容易捕捉水系精灵。"

msgid "tuxeball_wood"
msgstr "木系精灵球"

msgid "tuxeball_wood_description"
msgstr "更容易捕捉木系精灵。"

msgid "tuxeball_male"
msgstr "雄性精灵球"

msgid "tuxeball_male_description"
msgstr "更容易捕捉雄性精灵。"

msgid "tuxeball_female"
msgstr "雌性精灵球"

msgid "tuxeball_female_description"
msgstr "更容易捕捉雌性精灵。"

msgid "tuxeball_park"
msgstr "公园精灵球"

msgid "tuxeball_park_description"
msgstr "公园官方的捕捉装置，只在公园内有效。"

msgid "tuxeball_neuter"
msgstr "中性精灵球"

msgid "tuxeball_neuter_description"
msgstr "更容易捕捉中性精灵。"

msgid "tuxeball_candy"
msgstr "糖果精灵球"

msgid "tuxeball_candy_description"
msgstr "捕捉精灵，并在捕捉成功后使其等级提升1级。"

msgid "tuxeball_lavish"
msgstr "奢华精灵球"

msgid "tuxeball_lavish_description"
msgstr "捕捉率远高于高贵精灵球。"

msgid "tuxeball_ancient"
msgstr "远古精灵球"

msgid "tuxeball_ancient_description"
msgstr "这种精灵球制作于久远的年代，能够万无一失地捕捉任何精灵。"

msgid "tuxeball_crusher"
msgstr "粉碎精灵球"

msgid "tuxeball_crusher_description"
msgstr "这种精灵球能突破防御，对手精灵的防御越高，捕捉率就越高。若对方处于守护状态，则会捕捉失败。"

msgid "tuxeball_xero"
msgstr "Xero精灵球"

msgid "tuxeball_xero_description"
msgstr "这种奇特的精灵球在对手精灵与你的精灵属性不同时会提高捕捉成功率，属性相同时则会降低。"

msgid "tuxeball_omni"
msgstr "全能精灵球"

msgid "tuxeball_omni_description"
msgstr "这种奇特的精灵球在对手精灵与你的精灵属性相同时会提高捕捉成功率，属性不同时则会降低。"

msgid "tuxeball_hardened"
msgstr "坚硬精灵球"

msgid "tuxeball_hardened_description"
msgstr "用于捕捉精灵，捕捉失败时不会损坏。"

msgid "tuxeball_hearty"
msgstr "丰盛精灵球"

msgid "tuxeball_hearty_description"
msgstr "捕捉成功后，精灵的正面口味会变为丰盛。"

msgid "tuxeball_peppy"
msgstr "活力精灵球"

msgid "tuxeball_peppy_description"
msgstr "捕捉成功后，精灵的正面口味会变为活力。"

msgid "tuxeball_refined"
msgstr "精制精灵球"

msgid "tuxeball_refined_description"
msgstr "捕捉成功后，精灵的正面口味会变为精制。"

msgid "tuxeball_salty"
msgstr "咸味精灵球"

msgid "tuxeball_salty_description"
msgstr "捕捉成功后，精灵的正面口味会变为咸味。"

msgid "tuxeball_zesty"
msgstr "香辣精灵球"

msgid "tuxeball_zesty_description"
msgstr "捕捉成功后，精灵的正面口味会变为香辣。"

msgid "tuxeball_grand"
msgstr "豪华精灵球"

msgid "tuxeball_grand_description"
msgstr "捕捉率比奢华精灵球更胜一筹。"

msgid "tuxeball_majestic"
msgstr "庄严精灵球"

msgid "tuxeball_majestic_description"
msgstr "捕捉最难以捉摸的精灵的终极之选。"

msgid "tuxeball_noble"
msgstr "高贵精灵球"

msgid "tuxeball_noble_description"
msgstr "标准精灵球的适度升级版。"

msgid "tuxeball_diurnal"
msgstr "昼行精灵球"

msgid "tuxeball_diurnal_description"
msgstr "白天更容易捕捉精灵，但在夜晚效果会大打折扣。"

msgid "tuxeball_nocturnal"
msgstr "夜行精灵球"

msgid "tuxeball_nocturnal_description"
msgstr "夜晚更容易捕捉精灵，但在白天效果会大打折扣。"

msgid "tuxeball_gambler"
msgstr "赌徒精灵球"

msgid "tuxeball_gambler_description"
msgstr "这种精灵球以变幻莫测著称。捕捉率波动极大，捕捉精灵的成功率可能极低，也可能出奇地高。"

msgid "boost_armour"
msgstr "护甲增幅剂"

msgid "boost_armour_description"
msgstr "在本场战斗剩余时间内，防御提升2级。"

msgid "boost_dodge"
msgstr "闪避增幅剂"

msgid "boost_dodge_description"
msgstr "在本场战斗剩余时间内，闪避提升2级。"

msgid "boost_melee"
msgstr "近战增幅剂"

msgid "boost_melee_description"
msgstr "在本场战斗剩余时间内，近战提升2级。"

msgid "boost_ranged"
msgstr "远程增幅剂"

msgid "boost_ranged_description"
msgstr "在本场战斗剩余时间内，远程提升2级。"

msgid "boost_speed"
msgstr "速度增幅剂"

msgid "boost_speed_description"
msgstr "在本场战斗剩余时间内，速度提升2级。"

msgid "raise_armour"
msgstr "防御提升"

msgid "raise_armour_description"
msgstr "学习钻石的坚硬。锻炼防御。"

msgid "raise_dodge"
msgstr "闪避提升"

msgid "raise_dodge_description"
msgstr "学习欧泊的虹彩。锻炼闪避。"

msgid "raise_hp"
msgstr "生命提升"

msgid "raise_hp_description"
msgstr "学习石英的丰盈。锻炼生命。"

msgid "raise_melee"
msgstr "近战提升"

msgid "raise_melee_description"
msgstr "学习红宝石的愤怒。锻炼近战。"

msgid "raise_ranged"
msgstr "远程提升"

msgid "raise_ranged_description"
msgstr "学习祖母绿的精准。锻炼远程。"

msgid "raise_speed"
msgstr "速度提升"

msgid "raise_speed_description"
msgstr "学习尖晶石的敏捷。锻炼速度。"

msgid "alpha_seep"
msgstr "阿尔法渗出物"

msgid "alpha_seep_description"
msgstr "在顶级掠食者领地周期的巅峰期，从其气味腺中采集的浓稠黏液分泌物。"

msgid "repellent"
msgstr "驱虫剂"

msgid "repellent_description"
msgstr "用这种臭烘烘的喷雾驱赶野生精灵。"

msgid "poseidon"
msgstr "波塞冬"

msgid "poseidon_description"
msgstr "专业级鱼竿。"

msgid "neptune"
msgstr "尼普顿"

msgid "neptune_description"
msgstr "进阶鱼竿。"

msgid "hatchet"
msgstr "短斧"

msgid "hatchet_description"
msgstr "用短斧砍倒碍事的圆木。"

msgid "surfboard"
msgstr "冲浪板"

msgid "surfboard_description"
msgstr "妈妈送的礼物，能让你移动得更快。"

msgid "gold_pass"
msgstr "黄金通行证"

msgid "gold_pass_description"
msgstr "享受大教堂的豪华服务。"

msgid "dojo_pass"
msgstr "道场通行证"

msgid "dojo_pass_description"
msgstr "元素道场的单人入场凭证。"

msgid "book_wishes"
msgstr "愿望之书"

msgid "book_wishes_description"
msgstr "成就狂人列出的成就清单，等你来挑战。"

msgid "nu_phone"
msgstr "Nu 手机"

msgid "nu_phone_description"
msgstr "它的用处可多了，比如给家里打电话。"

msgid "bivouac"
msgstr "露营地"

msgid "bivouac_description"
msgstr "像在正规治疗中心一样休息。使用后消耗。"

msgid "drone"
msgstr "无人机"

msgid "drone_description"
msgstr "将队伍中的一只精灵与寄存中的一只精灵互换。"

msgid "spyder_pass"
msgstr "斯派德通行证"

msgid "spyder_pass_description"
msgstr "有了它，你就能进入只有斯派德同伙才该去的地方。"

msgid "app_radio"
msgstr "收音机应用"

msgid "app_radio_description"
msgstr "收听本地广播、任务动态与来自地区各地的环境闲聊。"

msgid "app_renaming"
msgstr "改名应用"

msgid "app_renaming_description"
msgstr "用新名字赋予你的精灵全新身份，让它真正属于你！"

msgid "p_trepidation"
msgstr "惊恐"

msgid "p_trepidation_description"
msgstr "画作《惊恐》，材质：布面油画。艺术家亲笔签名。"

msgid "p_starry_night"
msgstr "星夜"

msgid "p_starry_night_description"
msgstr "画作《星，星，星夜》，材质：布面油画。艺术家亲笔签名。"

msgid "p_monsters_eyes"
msgstr "四目相对"

msgid "p_monsters_eyes_description"
msgstr "画作《精灵四目相对》，材质：布面油画。艺术家亲笔签名。"

msgid "ancient_egg"
msgstr "远古蛋"

msgid "ancient_egg_description"
msgstr "一枚奇特的蛋。把它种下去，或许就会孵化。"

msgid "restoration"
msgstr "恢复剂"

msgid "restoration_description"
msgstr "解除目标当前受到的任何状态影响。"

msgid "cureall"
msgstr "百愈剂"

msgid "cureall_description"
msgstr "将你的精灵治愈至满生命，并解除所有状态。"

msgid "escape_key"
msgstr "逃脱钥匙"

msgid "escape_key_description"
msgstr "从后门悄悄溜走。"

msgid "unknown_object"
msgstr "未知物体"

msgid "unknown_object_description"
msgstr "来历与用途不明。使用前必须先鉴定。"

msgid "bite_of_despair"
msgstr "绝望之咬"

msgid "bite_of_despair_description"
msgstr "先是气味袭来，接着味道毫不留情地将你击溃。"

msgid "whispersoup"
msgstr "低语汤"

msgid "whispersoup_description"
msgstr "盛汤时汤勺不住颤抖。之后发生的事，无人敢提起。"

msgid "inferno_custard"
msgstr "地狱蛋奶酒"

msgid "inferno_custard_description"
msgstr "烫得无法入口，又被诅咒得无法忽视。碗中噼啪作响，满是悔恨。"

msgid "dread_omelette"
msgstr "恐惧煎蛋卷"

msgid "dread_omelette_description"
msgstr "它违背了口感与味道的法则，连餐具都要反抗。"

msgid "meal_dust"
msgstr "餐粉"

msgid "meal_dust_description"
msgstr "月光下研磨的天空田谷物细粉。柔韧轻盈，是烘焙、卷制与煎炸食物不可或缺的材料。"

msgid "sweetroot"
msgstr "甜根"

msgid "sweetroot_description"
msgstr "采自低语林间空地的发光块根。甘甜醇厚，带一丝柑橘般的辛香，最适合做甜点或酸味浇头。"

msgid "mistflour_eggs"
msgstr "雾粉蛋"

msgid "mistflour_eggs_description"
msgstr "栖云飞鸟产下的神秘蛋。蛋壳柔软，充满魔力气息，能让菜肴如梦幻般蓬松凝固。"

msgid "suncrust_butter"
msgstr "日壳黄油"

msgid "suncrust_butter_description"
msgstr "从日瓣花中压榨的金黄浓郁乳脂。温润顺滑，带淡淡草香，能让任何菜肴更柔软、鲜亮、醇厚。"

msgid "crackle_salt"
msgstr "噼啪盐"

msgid "crackle_salt_description"
msgstr "在回声洞穴中开采的闪亮矿物。为咸食增添劲感与光泽，有时还会在口中噼啪爆开！"

msgid "starpepper"
msgstr "星胡椒"

msgid "starpepper_description"
msgstr "只在星光下成熟的细小发光浆果。火热却甘甜，暖意撩人却不灼人。"

msgid "sky_feather"
msgstr "天空之羽"

msgid "sky_feather_description"
msgstr "从微风鸟迁徙后换下的羽毛中采得。纤巧轻盈，是清爽摆盘的酥脆宠儿。"

msgid "stonefruit_bulbs"
msgstr "石果球茎"

msgid "stonefruit_bulbs_description"
msgstr "产自火山谷地的饱满根茎植物。口感如肉般紧实，味道如菌菇般鲜美，令人满足。"

msgid "field_greens"
msgstr "野菜"

msgid "field_greens_description"
msgstr "随风变色的野生叶片。鲜亮辛辣，常鲜食，或稍稍加热至微微卷曲。"

msgid "beastmoss"
msgstr "兽苔"

msgid "beastmoss_description"
msgstr "附生在古老生物与圣石上的厚苔藓。耐嚼而质朴，最适合做酥脆卷饼或浓郁派点。"

msgid "glowfat"
msgstr "发光脂"

msgid "glowfat_description"
msgstr "从发光藤蔓或温顺兽花中熬制的油脂。质地丝滑，香气如黄油，用于烹饪或上光。"

msgid "moo_bloom"
msgstr "哞花"

msgid "moo_bloom_description"
msgstr "从温顺草原兽身上采集的乳白蜜汁。顺滑暖心，带有蜜草与糖茎的风味。"

msgid "zestsap"
msgstr "劲汁"

msgid "zestsap_description"
msgstr "从劲果树上汲取的带电糖浆。酸爽似柑橘，在舌尖上奇妙地跃动，能唤醒沉闷的风味。"

msgid "zestroot_wraps"
msgstr "劲根卷"

msgid "zestroot_wraps_description"
msgstr "可作食用卷皮的柔韧嫩茎。富有弹性，蕴含潜在辛香，深受柔软卷制菜肴喜爱。"

msgid "root_beast_bark"
msgstr "根兽树皮"

msgid "root_beast_bark_description"
msgstr "形似肋排的硬化植物肉条。烟熏多筋，带着原始的鲜味——调味如肉食者的美梦，却是纯植物制成。"

msgid "flamehorn_shank"
msgstr "焰角腿肉"

msgid "flamehorn_shank_description"
msgstr "从焰角植物上切下的厚片——那是专为煎烤而培育的巨型无感知火植物。浓烈焦香，嚼劲十足。"

msgid "spice_dust"
msgstr "香料粉"

msgid "spice_dust_description"
msgstr "蕴含潜在火系能量与劲果精华的碎晶。在舌尖上闪烁，以耀眼的火花唤醒任何菜肴。"

msgid "rub_pork_chops"
msgstr "按摩猪排"

msgid "rub_pork_chops_description"
msgstr "裹上噼啪粉的根兽树皮切片。烟熏、辛辣、猛烈——调味如原始肉排，却纯粹由植物驱动。"

msgid "mille_feuille"
msgstr "千层酥"

msgid "mille_feuille_description"
msgstr "以雾粉与哞花奶油制成的多层酥点。浓郁精致，层层叠满甜蜜。"

msgid "cheesecake"
msgstr "芝士蛋糕"

msgid "cheesecake_description"
msgstr "柔软的哞花蛋糕，缀以发光脂旋纹。奶香浓郁奢华，带着柔和的微光。"

msgid "cream_puffs"
msgstr "奶油泡芙"

msgid "cream_puffs_description"
msgstr "填满魔法奶油的甜根泡芙。轻盈蓬松，放纵得令人着迷。"

msgid "crepes"
msgstr "可丽饼"

msgid "crepes_description"
msgstr "薄透的餐粉可丽饼，卷着微光馅料。优雅甜美，带一点点辛辣。"

msgid "rub_steak"
msgstr "按摩牛排"

msgid "rub_steak_description"
msgstr "以香料晶揉搓的焰角风味烤肉。浓烈焦香，热力嗡鸣。"

msgid "meatballs"
msgstr "肉丸"

msgid "meatballs_description"
msgstr "裹着劲汁糖霜的碎石果球茎丸。饱满酸爽，魔幻般地令人满足。"

msgid "shell_tacos"
msgstr "贝壳塔可"

msgid "shell_tacos_description"
msgstr "野菜卷饼塔可，配劲根馅料与哞花酱。清爽弹牙，活力满满。"

msgid "potato_casserole"
msgstr "土豆砂锅"

msgid "potato_casserole_description"
msgstr "甜根与雾粉分层，浸在劲汁中烘烤。温暖酸爽，口感柔软。"

msgid "phyllo"
msgstr "菲洛酥皮"

msgid "phyllo_description"
msgstr "裹着酸爽兽苔的酥脆卷皮。层层纤薄，内馅浓郁质朴。"

msgid "croissants"
msgstr "可颂"

