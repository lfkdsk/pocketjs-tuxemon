node_modules/
dist/
__pycache__/
*.py[cod]

# Bun / editor noise
.DS_Store
*.swp
.pocket/

# Python virtualenvs (tools/battle-oracle, tools/upstream-*-oracle.py)
.venv/

# The Tuxemon source the importer reads (tools/fetch-tuxemon.sh)
.tuxemon-src/

# Local console builds and physical-device validation logs
.pocket-build/

# Machine-generated verification reports. The import coverage report is
# committed (CI's import-cleanliness check pins it); everything else here is
# regenerated by its verify/bench script and consumed only by humans.
reports/*
!reports/G1-coverage.md
!reports/G1-coverage.zh_CN.md

# Mutation runner's in-place verifier copy (tools/verify-web-zh-mutants.ts)
tools/.verify-web-zh-mutant.ts

# Generated PSP mainline segment envelopes (deterministic, regenerated by
# tools/psp-mainline.ts snapshots; not committed).
.psp-segments/
.psp-emu-memstick/
.psp-test-tmp/
