{
  "name": "pocket-tuxemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Tuxemon's world, imported into Pocket RPG Kit and played on PocketJS (desktop, web, PSP)",
  "workspaces": [
    "vendor/pocket-rpgkit/vendor/pocketjs"
  ],
  "scripts": {
    "setup": "git submodule update --init --recursive && bun install",
    "fetch:tuxemon": "sh tools/fetch-tuxemon.sh",
    "transcode:audio": "bun tools/transcode-audio.ts",
    "verify:audio": "bun tools/transcode-audio.ts --verify",
    "import": "bun gen-assets.ts",
    "gen-assets": "bun gen-assets.ts",
    "verify:terrain:determinism": "bun tools/verify-terrain-determinism.ts",
    "verify:terrain:collision": "python3 tools/verify-terrain-collision.py",
    "verify:g6:determinism": "bun tools/verify-g6-determinism.ts",
    "verify:g6:frozen": "bun tools/frozen-k1.ts",
    "verify:g6:locks": "bun tools/verify-g6-locks.ts",
    "report:seamless:divergence": "bun tools/report-seamless-divergence.ts",
    "record:seamless:prefixes": "bun tools/migrate-seamless-prefixes.ts",
    "verify:gb6:mainline": "bun tools/verify-gb6-mainline.ts",
    "verify:gb6:failures": "bun tools/verify-gb6-failures.ts",
    "verify:gb6:stateful": "GB6_VERIFY_MODE=stateful bun tools/verify-gb6-mainline.ts",
    "verify:gb6:rates": "GB6_VERIFY_MODE=rate-60 bun tools/verify-gb6-mainline.ts && GB6_VERIFY_MODE=rate-30 bun tools/verify-gb6-mainline.ts && GB6_VERIFY_MODE=rate-20 bun tools/verify-gb6-mainline.ts",
    "verify:gb6:full": "bun run verify:gb6:stateful && bun run verify:gb6:rates",
    "record:j1:mainline": "J1_JOURNEY_OUT=data/j1-captainreturns-journey.json bun tools/j1-journey.ts",
    "verify:j1:mainline": "bun tools/verify-j1-mainline.ts",
    "verify:chapters": "bun tools/verify-chapters.ts",
    "record:zh:tape": "bun tools/transcribe-zh-tape.ts",
    "verify:zh:tape": "bun tools/transcribe-zh-tape.ts --check",
    "record:en:demo": "bun tools/transcribe-en-demo-tape.ts",
    "verify:en:demo": "bun tools/transcribe-en-demo-tape.ts --check",
    "verify:zh:demo": "bun tools/verify-zh-demo.ts",
    "screens:zh:chapters": "bun tools/render-zh-chapter-thumbnails.ts",
    "verify:save": "bun tools/verify-save-resume.ts",
    "screens:save": "bun tools/render-save-screens.ts",
    "verify:j1:segment": "J1_VERIFY_MODE=segment bun tools/verify-j1-mainline.ts",
    "verify:j1:stateful": "J1_VERIFY_MODE=stateful bun tools/verify-j1-mainline.ts",
    "verify:j1:rates": "J1_VERIFY_MODE=rate-60 bun tools/verify-j1-mainline.ts && J1_VERIFY_MODE=rate-30 bun tools/verify-j1-mainline.ts && J1_VERIFY_MODE=rate-20 bun tools/verify-j1-mainline.ts",
    "verify:j1:full": "J1_VERIFY_MODE=full bun tools/verify-j1-mainline.ts",
    "record:j2:mainline": "J2_JOURNEY_OUT=data/j2-hospitalcure-journey.json bun tools/j2-journey.ts",
    "verify:j2:mainline": "bun tools/verify-j2-mainline.ts",
    "verify:j2:segment": "J2_VERIFY_MODE=segment bun tools/verify-j2-mainline.ts",
    "verify:j2:stateful": "J2_VERIFY_MODE=stateful bun tools/verify-j2-mainline.ts",
    "verify:j2:rates": "J2_VERIFY_MODE=rate-60 bun tools/verify-j2-mainline.ts && J2_VERIFY_MODE=rate-30 bun tools/verify-j2-mainline.ts && J2_VERIFY_MODE=rate-20 bun tools/verify-j2-mainline.ts",
    "verify:j2:full": "J2_VERIFY_MODE=full bun tools/verify-j2-mainline.ts",
    "record:j3:mainline": "J3_JOURNEY_OUT=data/j3-omnichannelradioannounce-journey.json bun tools/j3-journey.ts",
    "verify:j3:mainline": "bun tools/verify-j3-mainline.ts",
    "verify:j3:segment": "J3_VERIFY_MODE=segment bun tools/verify-j3-mainline.ts",
    "verify:j3:stateful": "J3_VERIFY_MODE=stateful bun tools/verify-j3-mainline.ts",
    "verify:j3:rates": "J3_VERIFY_MODE=rate-60 bun tools/verify-j3-mainline.ts && J3_VERIFY_MODE=rate-30 bun tools/verify-j3-mainline.ts && J3_VERIFY_MODE=rate-20 bun tools/verify-j3-mainline.ts",
    "verify:j3:full": "J3_VERIFY_MODE=full bun tools/verify-j3-mainline.ts",
    "record:j4:mainline": "J4_JOURNEY_OUT=data/j4-kernelquestdone-journey.json bun tools/j4-journey.ts",
    "verify:j4:mainline": "bun tools/verify-j4-mainline.ts",
    "verify:j4:segment": "J4_VERIFY_MODE=segment bun tools/verify-j4-mainline.ts",
    "verify:j4:stateful": "J4_VERIFY_MODE=stateful bun tools/verify-j4-mainline.ts",
    "verify:j4:rates": "J4_VERIFY_MODE=rate-60 bun tools/verify-j4-mainline.ts && J4_VERIFY_MODE=rate-30 bun tools/verify-j4-mainline.ts && J4_VERIFY_MODE=rate-20 bun tools/verify-j4-mainline.ts",
    "verify:j4:full": "J4_VERIFY_MODE=full bun tools/verify-j4-mainline.ts",
    "verify:goldens:sync": "bun tools/verify-goldens-sync.ts",
    "verify:bootworld:replay": "bun tools/verify-bootworld-replay.ts",
    "goldens:g6": "bun tools/update-g6-goldens.ts",
    "goldens:gb5:battle": "bun tools/update-gb5-battle-goldens.ts",
    "goldens:gb6:route": "bun tools/update-gb6-route-goldens.ts",
    "goldens:j1": "bun tools/update-j1-goldens.ts",
    "goldens:gi1a": "bun tools/update-gi1a-goldens.ts",
    "goldens:gi2a": "bun tools/update-gi2a-goldens.ts",
    "goldens:gi2b": "bun tools/update-gi2b-goldens.ts",
    "goldens:j2": "bun tools/update-j2-goldens.ts",
    "goldens:j3": "bun tools/update-j3-goldens.ts",
    "goldens:j4": "bun tools/update-j4-goldens.ts",
    "goldens:preview-seam": "bun tools/update-preview-seam-goldens.ts",
    "goldens:world": "bun tools/update-world-seam-goldens.ts",
    "goldens:daylight": "bun tools/update-daylight-goldens.ts",
    "goldens:ui-text:zh": "bun tools/update-ui-text-zh-goldens.ts",
    "goldens:gpc:zh": "bun tools/update-gpc-zh-goldens.ts",
    "bench:g6:quickjs": "bash tools/bench-g6-quickjs.sh",
    "bench:gb6:quickjs": "bash tools/bench-gb6-quickjs.sh",
    "bench:gb6:quickjs:cold": "GB6_COLD_RUNS=5 bash tools/bench-gb6-quickjs.sh",
    "bench:j3:quickjs": "bash tools/bench-j3-quickjs.sh",
    "bench:j4:quickjs": "bash tools/bench-j4-quickjs.sh",
    "bench:j3:quickjs:cold": "J3_COLD_RUNS=5 bash tools/bench-j3-quickjs.sh",
    "bench:indoor-fast-path": "bash tools/bench-indoor-fast-path.sh",
    "verify:preview:coverage": "bun tools/verify-preview-coverage.ts",
    "bench:cotton:quickjs": "bash tools/bench-cotton-quickjs.sh",
    "verify:world-cache": "bash tools/verify-world-cache-quickjs.sh",
    "verify:world-cache:cold": "WORLD_CACHE_COLD_RUNS=5 bash tools/verify-world-cache-quickjs.sh",
    "verify:weather-alloc": "bash tools/weather-alloc-regression.sh",
    "verify:weather-alloc-main": "bash tools/weather-alloc-main-diff.sh",
    "build:wasm": "bun vendor/pocket-rpgkit/vendor/pocketjs/tools/wasm.ts",
    "build": "bun tools/build.ts",
    "desktop": "bun tools/desktop.ts",
    "web": "bun tools/web.ts",
    "web:verify": "bun vendor/pocket-rpgkit/tools/web-verify.ts --site dist/web --out dist/web-verify",
    "verify:web:audio": "bun tools/verify-web-audio.ts",
    "verify:web:lang": "bun tools/verify-web-lang.ts",
    "test": "bun test tests/",
    "tsc": "bunx tsc --noEmit",
    "build:psp": "bun tools/psp.ts",
    "build:psp:zh": "bun tools/psp.ts --zh",
    "verify:psp:journey": "bun tools/verify-psp-journey.ts",
    "verify:psp:emu": "bun tools/verify-psp-emu.ts",
    "check:l10n": "bun tools/check-l10n.ts",
    "update:l10n-overrides": "bun tools/build-zh-overrides.ts",
    "verify:web:zh": "bun tools/verify-web-zh.ts",
    "font:cjk": "bun vendor/pocket-rpgkit/tools/cjk-font.ts --app=. --scan=dist/zh-text.txt",
    "check:cjk": "bun vendor/pocket-rpgkit/tools/cjk-font.ts --app=. --scan=dist/zh-text.txt --check"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@vue-jsx-vapor/runtime": "3.2.19",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@pocketjs/framework": "workspace:*",
    "solid-js": "^1.9"
  }
}
